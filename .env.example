# ---- Server ----
NODE_ENV=development
PORT=3001

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:3001

# ---- AWS ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Bedrock ----
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_REGION=us-east-1
KNOWLEDGE_BASE_ID=

# ---- DynamoDB ----
CLIENTS_TABLE=TransferReadyClients
ACCOUNTS_TABLE=TransferReadyAccounts
TRANSFERS_TABLE=TransferReadyTransfers
REQUIREMENTS_TABLE=TransferReadyRequirements
INTERACTIONS_TABLE=TransferReadyInteractions
DYNAMODB_ENDPOINT=

# ---- S3 ----
# Globally-unique: base name + your AWS account id, e.g. transferready-knowledge-<ACCOUNT_ID>
S3_KNOWLEDGE_BUCKET=
